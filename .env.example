# bou-bot configuration
# Copy to .env and fill in. NEVER commit .env — secrets only via env/file.

# --- Server ---
PORT=3210
ADMIN_TOKEN=change-me-long-random-string
DB_PATH=./data/bou-bot.db

# --- WhatsApp Cloud API (WA_PROVIDER=cloud) or simulator (WA_PROVIDER=mock) ---
WA_PROVIDER=mock
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=choose-a-verify-token
WA_GRAPH_VERSION=v23.0
# Dedicated bot number (E.164, digits only, no +): the number registered with Meta Cloud API
WA_BOT_NUMBER=

# --- Owner (account owner) ---
# Your personal WhatsApp number (digits only, no +): alerts + /takeover /resume commands
OWNER_PHONE=
OWNER_NAME=Janibul
# Auto-handled alert thread commands; alerts older than 24h use template fallback below
OWNER_ALERT_TEMPLATE=owner_alert

# --- Recipient (the consenting person) ---
# Recipient WhatsApp number (digits only, no +). Set when they opt in.
RECIPIENT_PHONE=
RECIPIENT_NAME=জান
RECIPIENT_TIMEZONE=Asia/Dhaka
# Messaging window (recipient-local, 24h HH:mm). Outside = quiet hours.
MSG_WINDOW_START=10:00
MSG_WINDOW_END=21:00
# Daily proactive cap + minimum hours between proactive check-ins
DAILY_PROACTIVE_CAP=3
MIN_PROACTIVE_INTERVAL_HOURS=4
# A conversation is "active" for this many minutes after her last message — no openers then
ACTIVE_CONVERSATION_MINS=30
# Inbound older than this is logged, not auto-answered (machine was asleep)
STALE_INBOUND_MINS=15

# --- LLM (LLM_PROVIDER=anthropic or mock) ---
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
# Chat model — do not append date suffixes
LLM_CHAT_MODEL=claude-opus-5-5
# Classifier is a bulk/extraction role — current-generation Haiku
LLM_CLASSIFIER_MODEL=claude-haiku-5-5
LLM_EFFORT=low
LLM_TIMEOUT_MS=20000
LLM_MAX_REPLY_TOKENS=1024

# --- Check-in templates (must be approved in Meta Business Manager; see doc/META-SETUP.md) ---
CHECKIN_TEMPLATES=checkin_1,checkin_2,checkin_3
CHECKIN_LANG=bn

# --- Identity disclosure ---
# Appended to proactive check-ins so the recipient always knows the sender is AI
SIGNATURE_LINE=— আপনার AI assistant 🤖
